<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root POM of the Alert Hub monorepo. It is BOTH:
    - the PARENT of every service: Spring Boot version, Java version, shared
      dependencies, dependency and plugin versions are set here once;
    - the AGGREGATOR: it lists the services so IntelliJ loads them together and
      `./mvnw -pl services/<name>-service` works from the root.
  Every service declares this file as its <parent> with
  <relativePath>../../pom.xml</relativePath>.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.mst.alerthub</groupId>
    <artifactId>alert-hub</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>alert-hub</name>

    <modules>
        <module>services/loader-service</module>
        <!-- Uncomment each line once that service folder exists: -->
        <!-- <module>services/security-service</module> -->
        <!-- <module>services/user-service</module> -->
        <!-- <module>services/metric-service</module> -->
        <!-- <module>services/action-service</module> -->
        <module>services/processor-service</module>
        <!-- <module>services/evaluation-service</module> -->
        <!-- <module>services/email-sender-service</module> -->
        <!-- <module>services/sms-sender-service</module> -->
        <module>services/logger-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Versions NOT managed by Spring Boot. Spring Boot's own versions are not overridden. -->
        <springdoc.version>3.2.0</springdoc.version>
        <!-- Spring Cloud release train compatible with Spring Boot 4.1.x (used for OpenFeign) -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <!--
      Managed versions: services that need these declare them WITHOUT a <version>.
      Nothing here is added to a service automatically.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- Spring Cloud versions (OpenFeign etc.) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Shared dependencies: EVERY service inherits these. Do not repeat them in a service pom.
      Service-specific ones (JPA, PostgreSQL, MongoDB, OpenFeign, springdoc) stay in the service pom.
    -->
    <dependencies>
        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Spring for Apache Kafka -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Development only: optional, so they are not packaged into the service jar -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test support for the shared starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Services declare spring-boot-maven-plugin in their own <build> (no version).
                  This configuration is inherited by them.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Lombok must be listed as an annotation processor on Java 23+ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              Load Mockito as a Java agent for tests (instead of self-attaching at runtime).
              Removes the "Mockito is currently self-attaching" and "Java agent has been
              loaded dynamically" warnings on Java 21+.
              Step 1: expose the mockito-core jar path as a Maven property.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Step 2: pass that jar to the test JVM as -javaagent -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
